# Caddyfile.mkcert.example — template for LAN HTTPS via mkcert.
#
# For LAN deployments reached by a name Let's Encrypt can't issue for (e.g.
# `wiki.lan`). Instead of a public ACME cert, Caddy serves a leaf cert you
# generate with mkcert, signed by mkcert's local CA. You trust that CA once on
# each client machine; redeploying Libreta (even on new hardware) never requires
# re-trusting, because the CA lives on your machine, not in the deployment.
#
# `make release` / `make setup-tls` fill in the __TLS_HOSTNAME__ and
# __HTTPS_PORT__ tokens below from TLS_HOSTNAME / LIBRETA_HTTPS_PORT and push the
# result to the host as Caddyfile.mkcert. To use it by hand, copy this file,
# replace both tokens, and mount it (see docs/site/claude-desktop.md).

{
    # No `email` and no public ACME issuer — Caddy just serves the mounted
    # cert. `auto_https off` keeps Caddy from trying to fetch a public
    # certificate for the LAN hostname (which would fail) — we provide the cert
    # explicitly below.
    auto_https off
}

# Site address: the LAN hostname plus the HTTPS port. The hostname must match
# the name passed to `mkcert` AND the URL clients use
# (https://<hostname>:<port>/mcp). The explicit port keeps HTTPS on the same
# port the plain-HTTP frontend used and stops Caddy serving plain HTTP on 80.
__TLS_HOSTNAME__:__HTTPS_PORT__ {
    encode zstd gzip

    request_body {
        max_size 50MB
    }

    # Leaf cert + key generated by mkcert, mounted by docker-compose.mkcert.yml.
    tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

    # `frontend-prod` is the nginx container in docker-compose.prod.yml; it
    # serves the SPA and proxies /api/ and /mcp to the backend internally.
    reverse_proxy frontend-prod:80
}
