# Local Makefile overrides — copy to `local.mk` and edit.
#
#   cp local.mk.example local.mk
#
# `local.mk` is gitignored. The Makefile `-include`s it, so any variable set
# here overrides the in-Makefile defaults without touching tracked files.
# The command line still wins over this file (`make release DEPLOY_HOST=...`).

# SSH target for `make release` / `make release-current` image deployment.
DEPLOY_HOST = user@homelab

# Directory on DEPLOY_HOST holding the prod compose files + .env. After loading
# the new image, the release recreates the stack with `docker compose up -d`
# there. Defaults to /home/user; override if your host differs.
DEPLOY_PATH = /home/user

# --- LAN HTTPS (optional) ---
# Set TLS_HOSTNAME to opt into HTTPS via mkcert + Caddy. When set, `make release`
# / `make setup-tls` generate a leaf cert locally (signed by your mkcert CA — run
# `mkcert -install` once), copy it + the Caddyfile + overlay to the host, and
# deploy behind Caddy. Leave it unset to deploy plain HTTP as before.
# Required for Claude Desktop's MCP endpoint (it needs HTTPS). See
# docs/site/claude-desktop.md.
#TLS_HOSTNAME = wiki.lan

# Host port Caddy serves HTTPS on (default 8091 — same port the plain frontend
# used, so the URL's port doesn't change). Must match Caddyfile.mkcert's site
# address; the release substitutes it for you.
#LIBRETA_HTTPS_PORT = 8091
